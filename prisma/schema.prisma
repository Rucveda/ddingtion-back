// 1. 클라이언트 및 DB 연결 설정
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 2. 상태값을 위한 Enum 정의
enum AuctionStatus {
  ACTIVE
  PENDING_TRADE
  COMPLETED
  CANCELED
  CANCEL_PENDING
  EXPIRED
}

// 💡 [추가] 게시글 타입을 구분하기 위한 Enum
enum PostType {
  NOTICE   // 시스템 공지 (관리자용)
  GENERAL  // 일반 게시글 (유저용)
  GUIDE    // 가이드/도움말
}

// 3. 모델 정의
model User {
  id                Int      @id @default(autoincrement())
  loginId           String   @unique
  passwordHash      String
  ingameName        String   @unique
  role              String   @default("USER") // "ADMIN" 포함
  isBanned         Boolean  @default(false) // 밴 상태
  bannedIp         String?  // 강력 밴 시 등록된 IP (관리자)
  reputationScore   Float    @default(0)
  reviewCount       Int      @default(0)
  successfulTrades  Int      @default(0)
  preferences       Json?

  // 💡 [추가] 디스코드 연동 기능 (고유 ID 저장용)
  discordId         String?  @unique

  // 관계 설정
  auctions           Auction[]      @relation("SellerAuctions")
  bids               Bid[]
  notifications      Notification[] 
  chatRoomsAsSeller  ChatRoom[]      @relation("SellerChatRooms")
  chatRoomsAsBuyer   ChatRoom[]      @relation("BuyerChatRooms")
  messages           Message[]
  givenReviews       Review[]        @relation("Reviewer")
  receivedReviews    Review[]        @relation("Reviewee")
  auctionComments    AuctionComment[]
  // 💡 [확장] 유저가 작성한 게시글 관계 추가
  posts              Post[]

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Item {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  iconUrl         String?
  category        String           // "WILD", "ISLAND", "RPG"
  auctions        Auction[]
  marketHistories MarketHistory[]
}

model Auction {
  id                 Int           @id @default(autoincrement())
  sellerId           Int
  itemId             Int
  description        String?       @db.Text
  
  enhancementLevel   Int           @default(0)
  enhancementRank    String?
  quality            Int?
  lampLines          Json?
  enchantments       Json?
  imprint            Json?
  skills             Json?
  runes              Json?
  
  startPrice         BigInt        
  currentPrice       BigInt
  buyNowPrice        BigInt?
  startTime          DateTime      @default(now())
  endTime            DateTime
  status             AuctionStatus @default(ACTIVE)
  cancelRequestedAt  DateTime?
  /** 재등록 완료 시각 — 동일 만료 건 중복 재등록 방지 */
  relistedAt         DateTime?

  seller             User          @relation("SellerAuctions", fields: [sellerId], references: [id])
  item               Item          @relation(fields: [itemId], references: [id])
  bids               Bid[]
  chatRoom           ChatRoom?
  reviews            Review[]
  comments           AuctionComment[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, endTime])
  @@index([itemId])
  @@index([sellerId])
}

// 💡 [신규/패치] 확장형 게시글 모델 (공지사항 포함)
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  type      PostType @default(GENERAL) // NOTICE로 설정 시 메인 팝업 노출 가능
  category  String   @default("GENERAL")
  
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  
  viewCount Int      @default(0)
  isPinned  Boolean  @default(false) // 중요 공지 상단 고정용
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type]) // 타입별 검색 최적화
  @@index([category])
}

model PostCategoryGuide {
  category  String   @id
  guideText String   @db.Text
  updatedAt DateTime @updatedAt
}

model Bid {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  bidderId    Int
  bidAmount   BigInt

  auction     Auction  @relation(fields: [auctionId], references: [id])
  bidder      User     @relation(fields: [bidderId], references: [id])

  createdAt   DateTime @default(now())

  @@index([auctionId, bidAmount(sort: Desc)])
  @@index([bidderId])
}

model AuctionComment {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  authorId    Int
  content     String   @db.Text

  auction     Auction  @relation(fields: [auctionId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id])

  createdAt   DateTime @default(now())

  @@index([auctionId, createdAt])
  @@index([authorId])
}

model MarketVariable {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  category  String
  label     String
  value     Float
  updatedAt DateTime @updatedAt
}

model MarketHistory {
  id                 Int      @id @default(autoincrement())
  auctionId          Int?     @unique
  itemId             Int
  item               Item     @relation(fields: [itemId], references: [id])
  
  enhancementLevel   Int      @default(0)
  enhancementRank    String?
  quality            Int?
  lampLines          Json?
  enchantments       Json?
  imprint            Json?
  skills             Json?
  runes              Json?
  
  price              BigInt
  tradeDate          DateTime @default(now())
  
  isLegacy           Boolean  @default(false)
  isValid            Boolean  @default(true)
  excludeReason      String?  @db.Text

  createdAt          DateTime @default(now())

  @@index([itemId, isValid, tradeDate(sort: Desc)])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   
  message   String   @db.Text
  link      String?  
  isRead    Boolean  @default(false)
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ChatRoom {
  id           Int      @id @default(autoincrement())
  auctionId    Int?     @unique
  sellerId     Int
  buyerId      Int
  status       String   @default("ACTIVE")
  sellerConfirmed Boolean @default(false)
  buyerConfirmed  Boolean @default(false)
  
  isAdminChat  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auction      Auction? @relation(fields: [auctionId], references: [id])
  seller       User     @relation("SellerChatRooms", fields: [sellerId], references: [id])
  buyer        User     @relation("BuyerChatRooms", fields: [buyerId], references: [id])
  messages     Message[]

  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([auctionId])
}

model Message {
  id        Int      @id @default(autoincrement())
  roomId    Int
  senderId  Int
  content   String   @db.Text
  isRead    Boolean  @default(false)

  room      ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id])

  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([roomId, isRead, senderId])
}

model Review {
  id          Int      @id @default(autoincrement())
  auctionId   Int
  reviewerId  Int
  revieweeId  Int
  rating      Int
  comment     String?  @db.Text

  auction     Auction  @relation(fields: [auctionId], references: [id])
  reviewer    User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee    User     @relation("Reviewee", fields: [revieweeId], references: [id])

  createdAt   DateTime @default(now())

  @@index([revieweeId])
  @@index([auctionId, reviewerId])
}
